{
 "campaign": "tr-birthday-2026",
 "updated": "2026-10-28T04:39:16+00:00",
 "total": 875,
 "states": 48,
 "featured": [
  {
   "id": "b425ff1d70",
   "name": "Pauline C.",
   "place": "Ithaca, NY",
   "message": "I wish for people to re-read your words spoken in March 1912: “We, here in America, hold in our hands the hopes of the world, the fate of the coming years…” Perhaps they would see anew what a treasure we have in this magnificent country and commit to saving it."
  },
  {
   "id": "31a3774827",
   "name": "Dagmara L.",
   "place": "Jackson Heights, NY",
   "message": "I wish for all of us to feel inspired to make gestures big or small in our own way preserving this beautiful land and its many landscapes ~ through our choices #beapickupartist"
  },
  {
   "id": "bc76ca29ae",
   "name": "L. W.",
   "place": "Salt Lake City, UT",
   "message": "I wish for open lands, clean rivers, and for neighbors to come together in peace and protect our natural beauty for future generations!"
  },
  {
   "id": "660b3dd1f0",
   "name": "Addison O.",
   "place": "Dickinson, ND",
   "message": "I wish for continued access to beautiful public lands, the disappearance of microplastics, and for everyone to just get along."
  },
  {
   "id": "ed8f423939",
   "name": "Katie B.",
   "place": "Knoxville, TN",
   "message": "I wish for enjoyment of our national parks, protection for our public lands, and the conservation of our native species."
  },
  {
   "id": "82f18e3b18",
   "name": "Megan G.",
   "place": "Wisconsin Rapids, WI",
   "message": "I wish for the natural beauty of the country to stay untouched and wild for our children and all who come after us."
  },
  {
   "id": "c92345d68f",
   "name": "Deni and Marv S.",
   "place": "Aurora, MN",
   "message": "I wish for responsible land usage including non-chemical ways to manage pest and crops in America's farmland. It needs to be less about yield and more about responsible/sustainable lands that can be used for many future generations."
  },
  {
   "id": "94e7f7b4a7",
   "name": "Candee C.",
   "place": "Kilgore, TX",
   "message": "I wish for strong character, integrity and a moral compass in our state and federal government's leadership. This will promote compassion for our fellow man along with preservation of our country's lands and all our vast heritage."
  },
  {
   "id": "8786750904",
   "name": "Aleah N.",
   "place": "Madison, WI",
   "message": "I wish for our lands and the animals that call them home to remain protected, for all to enjoy and slow down in nature. I wish for more connection and support among people; to move away from such division. Thank you TR for paving the way for conservation!"
  },
  {
   "id": "4b2869dbf1",
   "name": "Ann B.",
   "place": "West Des Moines, IA",
   "message": "I wish for wild horses, buffalo, wolves and other animals be valued and saved from the unscrupulous roundups and removal from our country. I wish for clean air, land and water in our land and fair treatment and care for the poor, the immigrants, the elderly and childr"
  },
  {
   "id": "8134196c0f",
   "name": "James W.",
   "place": "Farmington, MN",
   "message": "I wish for Clean water and clear blue skies. Thanks for your vision to protect are most natural and beautiful lands."
  },
  {
   "id": "efdf085cb3",
   "name": "Kathryn M.",
   "place": "Dayton, OH",
   "message": "I wish for Conservation and protection of our national parks and open spaces."
  }
 ],
