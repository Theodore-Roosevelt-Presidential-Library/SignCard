{
 "campaign": "tr-birthday-2026",
 "updated": "2026-10-29T04:59:08+00:00",
 "total": 1367,
 "states": 49,
 "featured": [
  {
   "id": "2c7e2b66a4",
   "name": "John W.",
   "place": "Nine Mile Falls, WA",
   "message": "I wish for clean air and water, wild land to roam free in, and a return to the conservation ethic that Theodore Roosevelt fostered. Thank you and happy birthday TR!"
  },
  {
   "id": "b0bdcd4e46",
   "name": "Stephen K.",
   "place": "Excelsior Springs, MO",
   "message": "I wish for Helpful neighbors, honest caretakers, healthy landscapes, plentiful wildlife."
  },
  {
   "id": "9fc134cb09",
   "name": "Mark A.",
   "place": "Chicago, IL",
   "message": "I wish for Happy 168th Birthday, Teddy Roosevelt! May we never lack the courage to stand for what's right, the strength to defend what matters, or the grit to face challenges head-on. Here's to strong leaders and leaving our country better than we found it."
  },
  {
   "id": "af165390ac",
   "name": "Andy ‘Anooshirvan’ B.",
   "place": "Herndon, VA",
   "message": "I wish for Realizing President Theodore Roosevelt’s eternal faith in America’s ‘bold and hearty’ race of people vigilantly passing on to the inheritance of future generations a greener more bountiful conservation heritage reflecting the best in our nature as Americans."
  },
  {
   "id": "9f44dd588a",
   "name": "Jay T.",
   "place": "Oakley, CA",
   "message": "I wish for Open land, clean rivers and neighbors who show up for each other. Thank you Mr.Roosevelt for preserving these wild lands that have shaped the man I am today."
  },
  {
   "id": "59a607c3c8",
   "name": "Robin B.",
   "place": "Crystal Lake, IL",
   "message": "I wish for a nation that embraces your courage, honors your commitment to conservation, and remembers that the true measure of patriotism is service to something greater than ourselves. Bully for you, Teddy!"
  },
  {
   "id": "55431bd0b2",
   "name": "Stacy H.",
   "place": "Detroit Lakes, MN",
   "message": "I wish for future generations to carry your adventurous spirit, courage, and love of the great outdoors. May we always remember to speak softly, carry a big stick, and live life boldly! Happy 168th, Teddy!"
  },
  {
   "id": "ec512be6c5",
   "name": "Ron J.",
   "place": "Mayville, ND",
   "message": "I wish for a brigher world where people care about the earth and its' resources; doing their best to care for them daily for future generations. And to be 'Bully' to protect not only the resources; but the rights of Americans to enjoy all this beauty! Happy Birthday TR!!"
  },
  {
   "id": "f887f1f5b0",
   "name": "Kathleen M.",
   "place": "Crescent City, CA",
   "message": "I wish for every nation to commit all their resources to reverse climate change, restore the lands by planting trees and rewilding urban areas as well as bringing our oceans back to life."
  },
  {
   "id": "b425ff1d70",
   "name": "Pauline C.",
   "place": "Ithaca, NY",
   "message": "I wish for people to re-read your words spoken in March 1912: “We, here in America, hold in our hands the hopes of the world, the fate of the coming years…” Perhaps they would see anew what a treasure we have in this magnificent country and commit to saving it."
  },
  {
   "id": "31a3774827",
   "name": "Dagmara L.",
   "place": "Jackson Heights, NY",
   "message": "I wish for all of us to feel inspired to make gestures big or small in our own way preserving this beautiful land and its many landscapes ~ through our choices #beapickupartist"
  },
  {
   "id": "bc76ca29ae",
   "name": "L. W.",
   "place": "Salt Lake City, UT",
   "message": "I wish for open lands, clean rivers, and for neighbors to come together in peace and protect our natural beauty for future generations!"
  }
 ],
